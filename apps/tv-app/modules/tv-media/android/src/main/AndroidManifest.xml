<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Self-update (D-062): hand a newer APK from the GitHub release to the system installer; the user confirms. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <!-- External players (D-057): Android 11+ only lists apps the manifest declares interest in. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="video/*" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="application/vnd.apple.mpegurl" />
    </intent>
  </queries>

  <application>
    <!-- Self-update (D-062): lets the system installer read the downloaded APK from the app cache. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.tvmedia.updates"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/tvmedia_update_paths" />
    </provider>
    <!-- Media3 DownloadService: keeps downloads running while the app is in the background. -->
    <service
      android:name="expo.modules.tvmedia.TvDownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync">
      <intent-filter>
        <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </service>
  </application>
</manifest>

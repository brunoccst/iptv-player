{
  "name": "iptv-player-monorepo",
  "private": true,
  "license": "MIT-0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web-player",
    "apps/tv-app",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "node scripts/dev.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@iptv/web-player",
    "dev:tv": "npm run start --workspace=@iptv/tv-app",
    "lint": "npm run lint:js && npm run lint:parity && npm run lint:features && npm run lint:release-notes && npm run lint:i18n && npm run lint:py",
    "lint:parity": "node --test scripts/check-parity.test.mjs && node scripts/check-parity.mjs",
    "lint:features": "node --test scripts/check-features-technical.test.mjs && node scripts/check-features-technical.mjs",
    "lint:release-notes": "node --test scripts/release-notes.test.mjs && node scripts/release-notes.mjs --check",
    "lint:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "i18n:sync": "node scripts/check-i18n.mjs --write",
    "lint:js": "eslint . --max-warnings=0 && prettier --check .",
    "lint:py": "python -m ruff check tools/fake-xtream-server scripts && python -m ruff format --check tools/fake-xtream-server scripts",
    "format": "prettier --write . && python -m ruff check --fix tools/fake-xtream-server scripts && python -m ruff format tools/fake-xtream-server scripts",
    "test:e2e": "npm run test:e2e --workspace=@iptv/web-player"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "react-native": "npm:react-native-tvos@0.86.3-0"
  }
}

{
  "name": "iptv-player-monorepo",
  "private": true,
  "license": "MIT-0",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "node scripts/dev.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@iptv/web-player",
    "dev:tv": "npm run start --workspace=@iptv/tv-app",
    "backend:build": "dotnet build backend/Backend.sln",
    "backend:test": "dotnet test backend/Backend.sln",
    "backend:run": "dotnet run --project backend/src/Backend.Api",
    "services:test": "cd services/title-normalizer && python -m pytest",
    "services:worker": "cd services/title-normalizer && python -m title_normalizer",
    "lint": "npm run lint:js && npm run lint:backend && npm run lint:py",
    "lint:js": "eslint . --max-warnings=0 && prettier --check .",
    "lint:backend": "dotnet format backend/Backend.sln --verify-no-changes",
    "lint:py": "cd services/title-normalizer && python -m ruff check . ../../tools/fake-xtream-server ../../scripts && python -m ruff format --check . ../../tools/fake-xtream-server ../../scripts",
    "format": "prettier --write . && dotnet format backend/Backend.sln && cd services/title-normalizer && python -m ruff check --fix . ../../tools/fake-xtream-server ../../scripts && python -m ruff format . ../../tools/fake-xtream-server ../../scripts",
    "test:e2e": "npm run test:e2e --workspace=@iptv/web-player"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "react-native": "npm:react-native-tvos@0.86.3-0"
  }
}

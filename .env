# Central app configuration. Public values only; secrets go in .env.local (git-ignored).
# Read by: web-player (Vite), tv-app (Expo app.config.ts), desktop (scripts/prepare.mjs).

APP_NAME=IPTV Player
APP_SLUG=iptv-player
APP_ANDROID_PACKAGE=com.iptvplayer.tv

# Sent to the IPTV provider; many panels only answer player-like agents.
APP_PROVIDER_USER_AGENT=VLC/3.0.21 LibVLC/3.0.21

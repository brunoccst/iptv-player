# Central app configuration. Public values only; secrets go in .env.local (git-ignored).
# Read by: web-player (Vite), tv-app (Expo app.config.ts), backend (.NET), services (Python).

APP_NAME=IPTV Player
APP_SLUG=iptv-player
APP_ANDROID_PACKAGE=com.iptvplayer.tv
APP_API_BASE_URL=http://localhost:5080

# Backend (.NET) settings. Not exposed to clients.
# Relative to this file. Shared by backend and services (SQLite files, encryption keys).
DATA_DIR=.data
BACKEND_STREAM_DELIVERY=relay
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
BACKEND_SESSION_DAYS=30
BACKEND_RELAY_TOKEN_HOURS=12
BACKEND_CATALOG_CACHE_MINUTES=15
BACKEND_PROVIDER_USER_AGENT=VLC/3.0.21 LibVLC/3.0.21
